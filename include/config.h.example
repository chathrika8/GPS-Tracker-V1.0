#pragma once

// ============================================================
// GPS Tracker — Configuration Template
// Copy this file to config.h and fill in your values.
// config.h is gitignored to keep credentials out of version control.
// ============================================================

// — Pin Definitions —
#define SIM800L_TX    20
#define SIM800L_RX    21
#define SIM800L_RST   0       // Using GPIO0 (PWRKEY equivalent)
#define SIM800L_RI    10      // Using GPIO10
#define GPS_TX        5       // NEO-6M RX
#define GPS_RX        4       // NEO-6M TX
#define I2C_SDA       8       // OLED SDA (pull-up inherently secures GPIO8 strapping HIGH)
#define I2C_SCL       9       // OLED SCL (pull-up inherently secures GPIO9 strapping HIGH)
#define BTN_A         3       // Button SELECT/CALL
#define BTN_B         1       // Button BACK/HANG

// — GPRS —
// Set to your carrier's APN. Leave USER/PASS blank for most carriers.
#define GPRS_APN      "your.carrier.apn"
#define GPRS_USER     ""
#define GPRS_PASS     ""

// — Wi-Fi (OTA & commands only) —
#define WIFI_SSID     "YourWiFiSSID"
#define WIFI_PASS     "YourWiFiPassword"

// — Cloudflare Proxy —
// The firmware posts to this host/path over raw TCP (port 80).
// Set up a Cloudflare Worker or similar HTTPS proxy to forward to Supabase.
#define PROXY_HOST      "api.yourdomain.com"
#define PROXY_PATH      "/uplink"
#define SUPABASE_TABLE  "locations"

// — GitHub OTA —
// Repository hosting firmware releases (tag format: v1.x.x)
#define GITHUB_REPO_OWNER  "youruser"
#define GITHUB_REPO_NAME   "gps-tracker-firmware"
#define GITHUB_TOKEN       ""   // Optional: for private repos (Personal Access Token)

// — Device Identity —
#define DEVICE_ID     "GPS-001"    // Unique ID sent with every packet
#define FW_VERSION    "1.1.0"      // Must match GitHub Release tag (without 'v')

// ============================================================
//  PAYLOAD PROFILE
// ============================================================
// Two wire formats are supported so both can be A/B tested in the field.
// The Cloudflare Worker must be updated to recognise whichever profile is active.
//
//   COMPACT  → binary frame, ~20 B/packet, Content-Type: application/octet-stream
//   FULL     → short-key JSON, ~80 B/packet, Content-Type: application/json
//
// On a SIM800/2G link a 5-packet COMPACT batch is ~110 B; a 5-packet FULL batch
// is ~430 B. COMPACT comfortably sustains 1 update/sec; FULL trades some headroom
// for human-readable wire format.
#define PAYLOAD_PROFILE_COMPACT  1
#define PAYLOAD_PROFILE_FULL     2
#define PAYLOAD_PROFILE          PAYLOAD_PROFILE_COMPACT

// — Timing (ms) —
#define GPS_READ_INTERVAL       400
#define BUFFER_INTERVAL_MOVING  1000      // 1 Hz packet rate when moving
#define BUFFER_INTERVAL_IDLE    15000     // 15 s when stationary (battery save)
#define SPEED_THRESHOLD_KMH     2.0       // moving vs stationary threshold
#define DISPLAY_REFRESH         100       // 10 Hz UI refresh
#define OTA_CHECK_INTERVAL      21600000  // 6 hours

// Adaptive batching: the uplink task sends as soon as either the batch fills
// or the interval elapses, whichever comes first. Keep MOVING small so motion
// reaches the server within a few seconds; let IDLE accumulate to amortise
// the per-uplink TCP cost.
#define UPLINK_BATCH_SIZE_MOVING   5      // 5 s of motion per uplink
#define UPLINK_BATCH_SIZE_IDLE     10     // amortise TCP cost when idle
// "Max latency" before flushing whatever is buffered. The uplink fires when
// either the batch fills OR this interval elapses, whichever comes first.
#define UPLINK_INTERVAL_MOVING     5000   // 5 s — flush even if batch isn't full
#define UPLINK_INTERVAL_IDLE       30000  // 30 s between idle uplinks

// HTTP/1.1 keep-alive: keep the TCP socket open across uplinks. Saves the
// ~5–10 s TCP handshake + GPRS PDP roundtrip on every cycle. The socket is
// recycled either when the server closes it or after this max age.
#define UPLINK_KEEPALIVE_MAX_AGE_MS  60000  // 60 s
#define BUTTON_DEBOUNCE              50

// — Tracking Schedule (defaults, overridden by dashboard) —
#define SCHEDULE_ENABLED  false

// — GPS UART —
// Set GPS_BAUD_TARGET above 9600 to unlock the 5 Hz output path in
// gps_manager.cpp. 38400 is a reliable middle ground on the NEO-6M; only
// drop back to 9600 if you see corrupted NMEA on serial.
#define GPS_BAUD_DEFAULT  9600
#define GPS_BAUD_TARGET   38400
#define GPS_UPDATE_RATE   5       // Hz

// ============================================================
//  AGPS — coarse position seed + ephemeris cache (always free)
// ============================================================
// On every boot the firmware injects a coarse position into the receiver
// via UBX-AID-INI and replays cached ephemerides via UBX-AID-EPH so the
// NEO-6M can skip the slow almanac search.
//
// Position seed source priority:
//   1. Last GPS fix from NVS (sub-km accurate)
//   2. Cell-tower position from AT+CIPGSMLOC (1–5 km, works at first boot)
//   3. None — fall back to standard cold-start
// Once GSM is up, if the cell-tower position disagrees with the NVS seed
// by more than AGPS_RESEED_KM kilometres, the firmware re-sends AID-INI
// with the cell position. Catches the case where the device was carried
// to a new location while powered off.
#define GPS_NVS_SAVE_INTERVAL_MS   30000     // save GPS fix to NVS every 30 s
#define CELL_NVS_SAVE_INTERVAL_MS  300000    // save cell fix to NVS every 5 min
#define EPH_POLL_INTERVAL_MS       1800000   // refresh ephemeris cache every 30 min
#define EPH_MAX_AGE_SEC            10800     // 3 h — broadcast eph validity
#define AGPS_RESEED_KM             50        // re-seed if cell ≠ NVS by > N km

// — Display —
#define OLED_WIDTH   128
#define OLED_HEIGHT  128
#define OLED_ADDR    0x3C
